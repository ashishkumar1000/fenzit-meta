node_modules/
npm-debug.log*
__pycache__/
*.pyc

# bun only — reject other package managers' lockfiles.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Cloned child repos are local working trees, not part of this repo's history.
workspace/core/*
!workspace/core/.gitkeep
workspace/external/*
!workspace/external/.gitkeep

# BMAD personal/local files (per-developer, not shared).
_bmad/config.user.toml

.env
.env.local
.DS_Store

# Editor/IDE state.
.idea/
.vscode/
*.iml

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
